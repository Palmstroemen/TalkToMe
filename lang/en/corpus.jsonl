# --- Long, natural commands
{"text": "I need a circle here now", "context": "fc114_sketcher", "expect": ["Sketcher_CreateCircle"]}
{"text": "Now please draw a line", "context": "fc114_sketcher", "expect": ["Sketcher_CreateLine"]}
{"text": "Make these two parallel", "context": "fc114_sketcher", "expect": ["Sketcher_ConstrainParallel"]}
{"text": "Now a chamfer on that edge", "context": "fc114_partdesign", "expect": ["PartDesign_Chamfer"]}
{"text": "Let's save this", "context": "fc114_partdesign", "expect": ["Std_Save"]}
{"text": "Make a hole please", "context": "fc114_partdesign", "expect": ["PartDesign_Hole"]}
