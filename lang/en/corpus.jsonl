# --- Switching workbenches
{"text": "Switch to Part Design", "context": "fc114_part", "expect": ["workbench:PartDesignWorkbench"]}
{"text": "Switch to the sketcher", "context": "fc114_part", "expect": ["workbench:SketcherWorkbench"]}

# --- Microphone off (exclusive) and training
{"text": "Microphone off", "context": "fc114_partdesign", "expect": ["ui:mic_off"]}
{"text": "Stop listening", "context": "fc114_partdesign", "expect": ["ui:mic_off"]}
{"text": "Take a short break", "context": "fc114_partdesign", "expect": ["ui:mic_off"]}
{"text": "Mic off", "context": "fc114_partdesign", "expect": ["ui:mic_off"]}
{"text": "Show the training", "context": "fc114_partdesign", "expect": ["ui:train"]}
{"text": "Let's train that", "context": "fc114_partdesign", "expect": ["ui:train"]}
{"text": "Training", "context": "fc114_partdesign", "expect": ["ui:train"]}
{"text": "Open the training window", "context": "fc114_partdesign", "expect": ["ui:train"]}

# --- Sequences and renaming
{"text": "Create a new body, call it base plate, and then a new sketch", "context": "fc114_partdesign", "expect": ["PartDesign_Body", {"command": "ui:rename", "args": {"label": "Base plate"}}, "PartDesign_NewSketch"]}
{"text": "Call it base plate", "context": "fc114_partdesign", "expect": [{"command": "ui:rename", "args": {"label": "Base plate"}}]}
{"text": "Let's call it lid", "context": "fc114_partdesign", "expect": [{"command": "ui:rename", "args": {"label": "Lid"}}]}
{"text": "Name it Bracket", "context": "fc114_partdesign", "expect": [{"command": "ui:rename", "args": {"label": "Bracket"}}]}
{"text": "Rename it to base plate", "context": "fc114_partdesign", "expect": [{"command": "ui:rename", "args": {"label": "Base plate"}}]}
{"text": "Please rename body 2 to base plate", "context": "fc114_partdesign", "expect": [{"command": "ui:rename", "args": {"label": "Base plate", "target": "body 2"}}]}

# --- Choosing a plane in the dialog
{"text": "XY plane", "context": "fc114_sketch_plane", "expect": ["ui:choose:XY-plane (Base plane)"]}
{"text": "The XZ plane", "context": "fc114_sketch_plane", "expect": ["ui:choose:XZ-plane (Base plane)"]}
{"text": "YZ plane", "context": "fc114_sketch_plane", "expect": ["ui:choose:YZ-plane (Base plane)"]}
{"text": "Cancel", "context": "fc114_sketch_plane", "expect": ["ui:cancel"]}

# --- Sketcher
{"text": "Rectangle", "context": "fc114_sketcher", "expect": ["Sketcher_CreateRectangle"]}
{"text": "Draw a line", "context": "fc114_sketcher", "expect": ["Sketcher_CreateLine"]}
{"text": "Polyline", "context": "fc114_sketcher", "expect": ["Sketcher_CreatePolyline"]}
{"text": "Leave sketch", "context": "fc114_sketcher", "expect": ["Sketcher_LeaveSketch"]}
{"text": "Parallel constraint", "context": "fc114_sketcher", "expect": ["Sketcher_ConstrainParallel"]}
{"text": "Parallel", "context": "fc114_sketcher", "expect": ["Sketcher_ConstrainParallel"]}
{"text": "Perpendicular", "context": "fc114_sketcher", "expect": ["Sketcher_ConstrainPerpendicular"]}
{"text": "Symmetric", "context": "fc114_sketcher", "expect": ["Sketcher_ConstrainSymmetric"]}
{"text": "Circle", "context": "fc114_sketcher", "expect": ["Sketcher_CreateCircle"]}
{"text": "Ellipse", "context": "fc114_sketcher", "expect": ["Sketcher_CreateEllipseByCenter"]}
